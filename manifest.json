{
  "schemaVersion": 1,
  "id": "ismoil.memory",
  "name": "Memory",
  "version": "1.3.1",
  "author": "ismoil",
  "license": "MIT",
  "description": "RAM in the bar with a popup: usage bar, swap, the programs holding the most memory (stop one in two clicks), and colours that follow your theme — accent, then yellow, then red as memory fills up.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Memory",
    "description": "RAM free/used indicator; popup with swap and top processes; theme-coloured warning levels",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "display": "free",
      "warnPercent": 90,
      "interval": 3,
      "topProcesses": 10,
      "cautionPercent": 75
    },
    "schema": [
      {
        "key": "display",
        "type": "string",
        "label": "Bar label: free | used | percent | icon"
      },
      {
        "key": "cautionPercent",
        "type": "number",
        "label": "Turn yellow when used % reaches"
      },
      {
        "key": "warnPercent",
        "type": "number",
        "label": "Highlight when used % reaches"
      },
      {
        "key": "interval",
        "type": "number",
        "label": "Refresh interval (seconds)"
      },
      {
        "key": "topProcesses",
        "type": "number",
        "label": "Processes listed (1–20; the popup offers 5, 10, 15)"
      }
    ]
  }
}
